# Praxis Stack env template — copy to a non-repo path, fill in, never commit.
# Generate tokens: bash deploy/gen-secrets.sh

PRAXIS_DATA_DIR=./data
PRAXIS_BIND_HOST=localhost
PORT=8787

# Three distinct secrets, 32+ bytes each.
PRAXIS_CONTROL_TOKEN=
FOUNDRY_CONTROL_TOKEN=
INTEGRATION_GATEWAY_TOKEN=

# Public exposure: leave empty for pure-loopback use.
# Wildcard-interface binding REQUIRES PRAXIS_PUBLIC_BEHIND_TLS=true and a TLS proxy in front.
PRAXIS_PUBLIC_URL=
PRAXIS_PUBLIC_BEHIND_TLS=false

# Execution backend: stub this round. T340 flip is config-only when the runner returns.
PRAXIS_EXECUTION_BACKEND=stub
PRAXIS_T340_URL=
PRAXIS_T340_TOKEN=

# Embedder sidecar (optional). URL is loopback-only HTTP. Set all three together or none.
# MODEL_SHA: full 64-hex sha256 of the pinned ONNX weights (40-hex legacy accepted).
PRAXIS_EMBEDDER_URL=
PRAXIS_EMBEDDER_MODEL=
PRAXIS_EMBEDDER_MODEL_SHA=
PRAXIS_EMBEDDER_TOKEN=
PRAXIS_EMBEDDER_TIMEOUT_MS=30000

# Miner sidecar (optional). URL is loopback-only HTTP.
# Use the full 64-hex Ollama sha256 digest; never truncate.
PRAXIS_MINER_URL=
PRAXIS_MINER_TOKEN=
PRAXIS_MINER_MODEL_SHA=

# Evidence provider identification (optional)
UNPAYWALL_EMAIL=
GITHUB_TOKEN=
NVD_API_KEY=
