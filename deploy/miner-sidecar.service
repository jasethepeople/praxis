[Unit]
Description=Praxis miner sidecar
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/apps/praxis
EnvironmentFile=%h/.config/praxis/env
Environment=PATH=%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=MINER_SIDECAR_PORT=8791
Environment=MINER_SIDECAR_OLLAMA_URL=http://localhost:11434
ExecStart=/usr/bin/env bun sidecar/miner-sidecar.ts
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/praxis

[Install]
WantedBy=default.target
